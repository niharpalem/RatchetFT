# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored — never commit real tokens.

# HuggingFace access token — used for model/dataset downloads.
# Create one at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Compute backend: "local" (default, trains on your GPU) or "modal" (cloud GPU).
# For Modal, also run:  modal setup  &&  modal secret create huggingface HF_TOKEN=<token>
RATCHETFT_BACKEND=local
